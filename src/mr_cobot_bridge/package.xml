<?xml version="1.0"?>
<package format="3">
  <name>mr_cobot_bridge</name>
  <version>1.0.0</version>
  <description>Puente logistico en el equipo del JetCobot (requiere los paquetes del cobot en robots_ws: jc_interfaces y jc_apps/pick_place_node).</description>
  <maintainer email="julianrenechaux@gmail.com">Julian Rene Chaux Cedeno</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mr_interfaces</exec_depend>
  <exec_depend>jc_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
