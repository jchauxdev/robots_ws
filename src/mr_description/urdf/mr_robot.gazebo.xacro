<?xml version="1.0"?>
<!-- Plugins y sensores para Gazebo Fortress (ros_gz, ROS 2 Humble). Requiere GPU para gpu_lidar y camera. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="caster_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <gazebo>
    <!-- Cinematica diferencial: mismos parametros nominales que mr_base (wheel_separation, wheel_radius) -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <tf_topic>tf</tf_topic>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="laser">
    <sensor name="rplidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <ignition_frame_id>laser</ignition_frame_id>
      <update_rate>8</update_rate>          <!-- RPLidar A1: ~5.5-10 Hz -->
      <lidar>
        <scan><horizontal><samples>720</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rgb_camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>camera/image_raw</topic>
      <ignition_frame_id>rgb_camera_optical_frame</ignition_frame_id>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20</far></clip>
      </camera>
      <always_on>1</always_on>
    </sensor>
  </gazebo>
</robot>
