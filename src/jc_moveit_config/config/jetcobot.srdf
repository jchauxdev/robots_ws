<?xml version="1.0" encoding="UTF-8"?>
<!-- Descripcion semantica (SRDF) del JetCobot para MoveIt 2 -->
<robot name="jetcobot">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <link name="gripper_base"/>
    <link name="gripper_left_finger"/>
    <link name="gripper_right_finger"/>
    <joint name="gripper_left_joint"/>
    <joint name="gripper_right_joint"/>
  </group>

  <!-- Estados con nombre (radianes). home = configuracion cero de pymycobot -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0"/><joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="0"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0"/><joint name="joint3" value="-1.5708"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="0"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="observe" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0.1745"/><joint name="joint3" value="-1.0472"/>
    <joint name="joint4" value="-0.6981"/><joint name="joint5" value="0"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_left_joint" value="0.017"/><joint name="gripper_right_joint" value="0.017"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="gripper_left_joint" value="0.0"/><joint name="gripper_right_joint" value="0.0"/>
  </group_state>

  <end_effector name="hand" parent_link="tcp" group="gripper" parent_group="arm"/>

  <!-- Pares de colision deshabilitados (adyacentes o que nunca colisionan) -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6_flange" reason="Never"/>
  <disable_collisions link1="link5" link2="link6_flange" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="link5" link2="camera_link" reason="Never"/>
  <disable_collisions link1="link6_flange" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="link6_flange" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="link6_flange" link2="gripper_left_finger" reason="Never"/>
  <disable_collisions link1="link6_flange" link2="gripper_right_finger" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger" link2="gripper_right_finger" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_left_finger" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_right_finger" reason="Never"/>
</robot>
