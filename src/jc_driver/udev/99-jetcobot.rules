# Regla udev de ejemplo: crea /dev/jetcobot y da acceso al grupo dialout.
# 1) Identifique su adaptador:  udevadm info -a -n /dev/ttyUSB0 | grep -E "idVendor|idProduct|serial" | head
# 2) Reemplace idVendor/idProduct por los valores reales (ejemplos comunes:
#    CP210x 10c4:ea60, CH340 1a86:7523, CH9102 1a86:55d4).
# ID_MM_DEVICE_IGNORE: ModemManager no prueba el puerto (si lo hace, el puente pierde la comunicacion)
# 3) sudo cp 99-jetcobot.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# CH340 (1a86:7523): adaptador del JetCobot de Yahboom verificado con lsusb. En JetPack 6 (R36) el kernel no trae el
#   controlador ch341: si /dev/ttyUSB0 no aparece, compilelo (DA-14, Paso 2).
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="jetcobot", MODE="0666", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"
# CH9102 (1a86:55d4): otras unidades del myCobot 280
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", SYMLINK+="jetcobot", MODE="0666", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"
