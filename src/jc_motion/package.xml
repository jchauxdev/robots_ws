<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jc_motion</name>
  <version>1.0.0</version>
  <description>Nodos C++ de movimiento con MoveIt 2: servidor de servicios y demo de objetivos de pose.</description>
  <maintainer email="julianrenechaux@gmail.com">Julian Rene Chaux Cedeno</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>jc_interfaces</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <exec_depend>jc_moveit_config</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
