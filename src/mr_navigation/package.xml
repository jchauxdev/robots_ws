<?xml version="1.0"?>
<package format="3">
  <name>mr_navigation</name>
  <version>1.0.0</version>
  <description>Puntos con nombre en el mapa, ordenes "ir al punto X" y recorridos sobre Nav2.</description>
  <maintainer email="julianrenechaux@gmail.com">Julian Rene Chaux Cedeno</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mr_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
