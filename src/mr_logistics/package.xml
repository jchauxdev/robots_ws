<?xml version="1.0"?>
<package format="3">
  <name>mr_logistics</name>
  <version>1.0.0</version>
  <description>App web de logistica en Python (Flask) y gestor de misiones: pedido -> cobot -> estacion de entrega.</description>
  <maintainer email="julianrenechaux@gmail.com">Julian Rene Chaux Cedeno</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mr_interfaces</exec_depend>
  <exec_depend>mr_navigation</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
