<?xml version="1.0"?>
<!-- Elementos especificos de Gazebo Fortress (ignition) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="jetcobot_gazebo" params="prefix:='' controllers_file">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

    <!-- Friccion alta en los dedos para facilitar el agarre simulado -->
    <gazebo reference="${prefix}gripper_left_finger">
      <mu1>2.0</mu1><mu2>2.0</mu2>
    </gazebo>
    <gazebo reference="${prefix}gripper_right_finger">
      <mu1>2.0</mu1><mu2>2.0</mu2>
    </gazebo>

    <!-- Camara RGB 640x480 en la muneca. FOV horizontal ~ 1.047 rad (60 grados) -->
    <gazebo reference="${prefix}camera_link">
      <sensor name="wrist_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/wrist_camera/image_raw</topic>
        <ignition_frame_id>${prefix}camera_optical_frame</ignition_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>3.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
