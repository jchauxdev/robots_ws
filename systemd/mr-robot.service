# Arranque automatico de los drivers del robot al encender la Jetson.
# Instalar:  sudo cp mr-robot.service /etc/systemd/system/ && sudo systemctl daemon-reload
#            sudo systemctl enable --now mr-robot.service      (ver estado: systemctl status mr-robot)
# Ajuste User y rutas. En la Jetson Nano use la variante con Docker (ExecStart comentado abajo).
[Unit]
Description=Robot movil SENA - drivers ROS 2 (mr_bringup robot.launch.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot
Environment=ROS_DOMAIN_ID=20
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source $HOME/robots_ws/install/setup.bash && ros2 launch mr_bringup robot.launch.py'
# Jetson Nano (contenedor):
# ExecStart=/usr/bin/docker run --rm --runtime nvidia --network host --ipc host --privileged -v /dev:/dev -v /home/robot/robots_ws:/root/robots_ws -e ROS_DOMAIN_ID=20 --name mr_robot mr_robot:humble-nano bash -lc 'source /root/.bashrc; ros2 launch mr_bringup robot.launch.py'
# ExecStop=/usr/bin/docker stop mr_robot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
